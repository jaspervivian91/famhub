# Family Hub — Environment Variables
# Copy this file to .env and fill in values.
# Do NOT commit .env to version control.

# Neon Postgres connection string (serverless driver).
# Without this, the app runs in fallback/mock mode.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# HomeStory Premium — one-off £24.99 per home, Stripe Checkout (mode=payment).
# The secret key stays server-side; the browser never sees it.
STRIPE_SECRET_KEY=
# The seller details a distance sale must show before payment. Until every one
# of these is set, the Premium page says it is not on sale yet and no money is taken.
PREMIUM_SELLER_NAME=
PREMIUM_SELLER_ADDRESS=
PREMIUM_SELLER_EMAIL=
PREMIUM_VAT_STATUS=
PREMIUM_REFUND_POLICY_URL=
