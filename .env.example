# Family Hub — Environment Variables
# Copy this file to .env and fill in values.
# Do NOT commit .env to version control.

# Neon Postgres connection string (serverless driver).
# Without this, the app runs in fallback/mock mode.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# HomeStory Premium — one-off £24.99 per home.
# The live buy path is the hosted Stripe payment link (src/lib/premium.ts), which
# needs no key. STRIPE_SECRET_KEY is optional: set it and the server can create
# its own Checkout Session instead; leave it unset and the link is used.
STRIPE_SECRET_KEY=
# The admin token that opens /admin/premium, where a payment is matched to a home
# by hand. Unset, that screen and its API answer 404.
PREMIUM_ADMIN_TOKEN=
# The seller details a distance sale must show before payment. Unset ones read
# "Not yet set" on the Premium page.
PREMIUM_SELLER_NAME=
PREMIUM_SELLER_ADDRESS=
PREMIUM_SELLER_EMAIL=
PREMIUM_VAT_STATUS=
PREMIUM_REFUND_POLICY_URL=
